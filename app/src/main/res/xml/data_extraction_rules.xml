<?xml version="1.0" encoding="utf-8"?>
<!-- Backups and phone-to-phone moves carry her memory, your name and settings; the brains are too big and download again. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="memory.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
